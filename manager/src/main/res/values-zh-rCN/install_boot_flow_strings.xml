<?xml version="1.0" encoding="utf-8"?>
<!-- 四步流程（选 Ultra → 选 boot → 选内核版本 → 修补成功）的中文文案；与 values 同名同义。 -->
<resources>
    <!-- 步骤标题 -->
    <string name="install_step_ultra">① 选择 Ultra 模式</string>
    <string name="install_step_ultra_summary">完整 Ultra boot：把 Ultra 内核修补进 boot.img</string>
    <string name="install_step_boot">启动镜像</string>
    <string name="install_step_kernel">内核版本</string>
    <string name="install_kernel_series">%1$s 系列</string>

    <!-- 步骤 ① 目标工作模式 + 目标分区（Normal 可选 init_boot / boot，Ultra 固定） -->
    <string name="install_step_target_mode">目标工作模式</string>
    <string name="install_step_partition">目标镜像</string>
    <string name="install_partition_fixed">此模式下固定：%1$s</string>
    <string name="install_target_normal_ready">修补 %1$s · KernelSU %2$s</string>
    <string name="install_target_information">安装信息</string>
    <string name="install_kernel_pairing_required_title">需要 MapleSU 配对</string>
    <string name="install_kernel_pairing_required">请先完成 MapleSU 配对，然后重新打开安装页。</string>
    <string name="install_kernel_image_unreadable">请重新选择完整的原厂 boot 镜像。</string>
    <string name="install_kernel_unavailable_hint">请选择适用于当前设备的原厂 boot 镜像，或更新 MapleSU 后重试。</string>
    <string name="install_kernel_boot_image_hint">请确认您选择的是 boot 镜像，而非 init_boot。</string>

    <!-- 直装：从当前设备分区读源镜像（不需要用户先选文件） -->
    <string name="install_partition_extract_start">- 正在以 root 读取当前 %1$s 分区…</string>
    <string name="install_partition_extract_done">- 已读取 %1$s（%2$d 字节，sha256 %3$s）</string>
    <string name="install_partition_extract_failed">无法以 root 读取当前分区，未做任何修补或写入（%1$s）。请改用「选择文件并修补」并选择一份原厂镜像。</string>
    <string name="install_target_blocker_partition_fixed">%1$s 只能修补它自己的分区；要补别的分区请换一种模式。</string>
    <string name="install_target_blocker_partition_unsupported">不支持这个分区。可选分区：%1$s。</string>

    <!-- 步骤 ③：只列能被我们修补的那个版本 -->
    <string name="install_step_kernel_waiting">先选择 boot 镜像</string>
    <string name="install_step_kernel_selected">可修补</string>
    <string name="install_step_kernel_unavailable">该内核暂时无法修补</string>

    <!-- 可修补 / 修不了的原因（一码一文案） -->
    <string name="install_boot_support_site_coverage">已拒绝：该内核的补丁站点没有全部匹配参考构建（%1$s）。代码体是按另一个内核编译的，因此没有生成任何镜像。</string>
    <string name="install_boot_credential_required">本次安装凭据准备失败，请重试修补。已有配对与原始镜像保持不变。</string>
    <string name="install_boot_support_asset_invalid">该内核的补丁集不可用（%1$s）</string>
    <!-- Selected files are exported, independently of the running kernel. -->
    <string name="install_boot_release_mismatch">设备当前内核是 %1$s，而这个镜像来自 %2$s。修补镜像只保存到 Download，当前分区保持原样。</string>
    <string name="install_boot_error_code">错误码：%1$s</string>

    <!-- 步骤 ④：修补中 / 修补成功 / 修补失败 -->
    <string name="install_step4_patching">正在修补</string>
    <string name="install_step4_success">修补成功</string>
    <string name="install_step4_failed">修补失败</string>
    <string name="install_boot_stage_patching">正在修补镜像…</string>
    <string name="install_boot_stage_writing">正在写入 boot 分区…</string>
    <string name="install_boot_stage_awaiting_reboot">已写入，需要重启</string>
    <string name="install_boot_outcome_written">修补后的 Ultra boot 已写入 boot 分区。</string>
    <string name="install_boot_outcome_saved_only">只生成了修补后的 boot 镜像，没有写入任何分区。</string>
    <string name="install_boot_outcome_already_patched">该 boot 镜像已经包含 Ultra 内核。</string>
    <string name="install_boot_outcome_restored">写入失败，已还原原始镜像。</string>
    <string name="install_boot_outcome_recovery_required">写入失败且回滚也失败，需要救援。</string>
    <string name="install_boot_generated_notice">该补丁集由本机现场生成，尚未在设备上启动过。</string>

    <!-- 步骤 ④ 的两个动作（交付物的用法） -->
    <string name="install_boot_action_save">保存 boot</string>
    <string name="install_boot_action_flash">刷入</string>
    <string name="install_boot_save_done">已保存到 %1$s</string>
    <string name="install_boot_save_failed">保存 boot 失败（%1$s）</string>

    <!-- 修补日志（只在日志行里出现；结果页不展示） -->
    <string name="install_boot_generate_notice">本包没有 %1$s 的补丁集，正在本机现场生成（未上机验证）</string>
    <string name="install_boot_generate_failed">该内核的补丁集生成失败（%1$s）</string>
    <string name="install_boot_saved_no_root">没有 boot 分区访问权限；已只生成修补镜像。</string>
    <string name="install_boot_saved_no_transaction">当前入口无法直接写入分区；已只生成修补镜像。</string>
    <string name="install_boot_saved_release_mismatch">该镜像对应内核 %1$s，而设备当前内核是 %2$s；已只生成修补镜像。</string>
