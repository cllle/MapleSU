    <string name="install_paired_boot_select">选择或更换配套 boot</string>
    <string name="install_paired_boot_needed">请选择与此 init_boot 配套的 boot 镜像，修补后保存镜像。</string>
    <string name="install_paired_boot_checking">正在解析所选镜像组…</string>
    <string name="install_paired_boot_ready">已解析 %1$s · 修补并保存</string>
    <string name="install_paired_boot_current">当前设备 boot · %1$s</string>
